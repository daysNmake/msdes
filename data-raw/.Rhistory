# save trial ipd
data<-merge(IPD0,IPD1,IPD2, all=T)
View(IPD0)
View(IPD1)
# save trial ipd
data<-rbind(IPD0,IPD1,IPD2)
View(data)
cox<-coxph(formula = Surv(time, event) ~ 0, data=data)
summary(cox)
View(cox)
cox<-coxph(formula = Surv(time, event) ~ 1, data=data)
summary(cox)
cox<-coxph(formula = Surv(time, event) ~ arm, data=data)
summary(cox)
write.csv(data, "FREEDOMSII CDP3.csv")
