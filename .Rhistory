source("R/generate_inputs.R")
## Model inputs generated using the generate inputs function
# saves the input in a list
inputs <- gen_inputs()
# Global parameters of the model as they are common to all patients and treatments, WARDEN specific (not complete)
indicators <-1
source("R/generate_global_inputs_warden.R")
#Function to extract data from environments containing lists while indexing on a vector of treatments or severity states
source("R/pluck_vector_from_env.R")
# patient parameters reflecting heterogeneous characteristics that depend on treatment, the same for both packages
source("R/generate_individual_inputs_warden.R")
#functions to generate initial events and reaction events, WARDEN specific (not complete)
source("R/generate_initial_events_warden.R")
source("R/generate_reaction_events_warden.R")
# Add time to event for each patient for each of the treatments
# Setting trt to all treatments should mean that the event applies to all treatments
init_event_list <- gen_init_events(RRMS_events=v_event_names) #functions do not accept named vectors of EDSS0-9 or dmt names
evt_react_list <- gen_react_events(RRMS_events=v_event_names) #functions do not accept named vectors of EDSS0-9 or dmt names
#util_ongoing_list <- gen_util_ongoing(dmt=v_treatment_names, severity = v_edss_values, RRMS_events=v_event_names)
util_ongoing <- "utilities_disease"
cost_ongoing <- "costs_disease"
util_instant <- c("utilities_relapse", "utilities_sae")
cost_instant <- c("costs_treatment", "costs_relapse", "costs_sae")
# Run the simulation
#Logic is: per patient, per intervention, per event, react to that event.
total_runtime <- system.time({
results <- run_sim_parallel(                                  # use run_sim_parallel() for more than 1 simulation, although I've experienced errors
npats = n_patients,                               # number of patients to be simulated
n_sim = n_samples,                                  # number of simulations to run
psa_bool = TRUE,                         # use PSA or not. If n_sim > 1 and psa_bool = FALSE, then difference in outcomes is due to sampling (number of pats simulated)
debug = FALSE,
sensitivity_bool= FALSE,                  # sensitivity analysis not implemented,
arm_list = v_treatment_names,             # intervention list
common_all_inputs = common_all_inputs,    # inputs common that do not change within a simulation
#common_pt_inputs = common_pt_inputs,     # inputs that change within a simulation but are not affected by the intervention
unique_pt_inputs = unique_pt_inputs,      # inputs that change within a simulation between interventions
init_event_list = init_event_list,        # initial event list
evt_react_list = evt_react_list,          # reaction of events
util_ongoing_list = util_ongoing,         # ongoing rrms or spms disease utilities
cost_ongoing_list = cost_ongoing,         # ongoing rrms or spms disease costs
util_instant_list = util_instant,
cost_instant_list = cost_instant,         # instantaneous treatment costs
# ncores = 4,                               # number of cores to use, recommended not to use all
input_out=c("age", "sex", "spms_flag", "edss_value", "n_relapse", "n_sae_evts", "n_edssinc_evts", "n_edssdec_evts", "current_treatment_code",
"treatment_line", "n_switch", "years_on_treatment", "treatment_stop", "t_2ndline", "t_3rdline", "t_4thline", "waning"),
# v_random_seed_sequence = c(1:n_samples), # Sequence of random seeds
# save_input_matrix = TRUE # Export the input matrix for EVPPI
)
})
n_spms_ipd <- n_relapse_ipd <-  n_edssincrease_ipd<- n_edssdecrease_ipd<- n_sae_ipd<-
final_edss_value_ipd <- death_ipd<- array(NA, dim = c(n_samples, n_treatments, n_patients),
dimnames = list(NULL, v_treatment_names, NULL))
# Below is not very efficient but only needs to be run once at end of simulation
#  results[[1]][[i_sample]] and $arm works for WARDEN to run for DESCEM replace  with results$output_psa[[i_sample]] and $trt
for(treatment_name in v_treatment_names) {
for(i_sample in 1:n_samples) {
for(i_patient in 1:n_patients) {
# With statement is neater but much slower
temp_index <- results[[1]][[i_sample]]$merged_df$pat_id == i_patient &
results[[1]][[i_sample]]$merged_df$arm == treatment_name &
results[[1]][[i_sample]]$merged_df$evtname == "death" # condition on death to count final n relapses and edss value
n_relapse_ipd[i_sample, treatment_name, i_patient] <-
results[[1]][[i_sample]]$merged_df$n_relapse[temp_index]
n_spms_ipd[i_sample, treatment_name, i_patient] <-
results[[1]][[i_sample]]$merged_df$spms_flag[temp_index]
n_edssincrease_ipd[i_sample, treatment_name, i_patient] <-
results[[1]][[i_sample]]$merged_df$n_edssinc_evts[temp_index]
n_edssdecrease_ipd[i_sample, treatment_name, i_patient] <-
results[[1]][[i_sample]]$merged_df$n_edssdec_evts[temp_index]
n_sae_ipd[i_sample, treatment_name, i_patient] <-
results[[1]][[i_sample]]$merged_df$n_sae_evts[temp_index]
final_edss_value_ipd[i_sample, treatment_name, i_patient] <-
results[[1]][[i_sample]]$merged_df$edss_value[temp_index]
death_ipd[i_sample, treatment_name, i_patient] <-
results[[1]][[i_sample]]$merged_df$evttime[temp_index]
} # End loop over patients
# Summarise for just this sample
}
}
# Take mean over patients to remove individual variation
total_n_relapse <- apply(n_relapse_ipd, c(1, 2), mean)
total_n_spms <- apply(n_relapse_ipd, c(1, 2), mean)
total_edss_increases <- apply(n_edssincrease_ipd, c(1, 2), mean)
total_edss_decreases <- apply(n_edssdecrease_ipd, c(1, 2), mean)
total_saes <- apply(n_sae_ipd, c(1, 2), mean)
total_final_edss_value <- apply(final_edss_value_ipd, c(1, 2), mean)
#compare events by treatment groups
n_spms_trt <- n_rel_trt<- n_edssincrease_trt<- n_edssdecrease_trt<- n_saes_trt<- n_final_edss_value<- c(rep(0, length(v_treatment_names)))
names(n_rel_trt) <- names(n_edssincrease_trt) <- names(n_edssdecrease_trt) <- names(n_saes_trt) <- names(n_final_edss_value) <- v_treatment_names
# summarise results
for (i  in 1:length(v_treatment_names)) {
n_spms_trt[i] <- summarise_samples(total_n_spms[,i])
n_rel_trt[i] <- summarise_samples(total_n_relapse[,i])
n_edssincrease_trt[i] <- summarise_samples(total_edss_increases[,i])
n_edssdecrease_trt[i] <- summarise_samples(total_edss_decreases[,i])
n_saes_trt[i] <- summarise_samples(total_saes[,i])
n_final_edss_value[i] <- summarise_samples(total_final_edss_value[,i])
}
key_events_trt_grps <- as.data.frame(cbind(n_spms_trt, n_rel_trt, n_edssincrease_trt, n_edssdecrease_trt, n_saes_trt, n_final_edss_value)
)
View(key_events_trt_grps)
## mortality by treatment group
# Sort death times ascending
for (i_sample in 1:n_samples){
for(treatment_name in v_treatment_names){
death_ipd[i_sample, treatment_name,] <- sort(death_ipd[i_sample, treatment_name,])
}}
# save event times in a list
for (i in 1:n_treatments){
assign(paste("V", i, sep=""), matrix(rep(0, n_patients* n_samples) , nrow = n_patients, ncol =  n_samples))
assign(paste("V", i, sep=""), tibble::as_tibble(death_ipd[,i,]))
}
xyz<-list(V1, V2, V3, V4, V5, V6, V7, V8) #xyz <- list(c(noquote(paste("V", 1:n_treatments, "," , sep="")),n_treatments))
#model the overall survial
for (i in 1:length(xyz)){
xyz[[i]] <- data.frame(xyz[[i]]) %>%
mutate(event = 1) %>%
pivot_longer(cols=starts_with("V"), values_to = "time")
xyz[[i]] <- data.frame(xyz[[i]][-2])
xyz[[i]] <- sort_by.data.frame(xyz[[i]], xyz[[i]][["time"]])
xyz[["model"]][[i]] <- survival::survfit(Surv(time, event)~1, data =xyz[[i]] , type="kaplan-meier")
xyz[["plot"]][[i]] <- data.frame(xyz[["model"]][[i]][["time"]], xyz[["model"]][[i]][["surv"]])
#xyz[[i]] <- xyz[[i]]
}
library(ggplot2)
# plot overall survival by treatment
plot_mortality<-
ggplot()+
geom_step(size=1)+
geom_step(data=xyz[["plot"]][[1]], aes(xyz[["plot"]][[1]][[1]], xyz[["plot"]][[1]][[2]], col=v_treatment_names[1]), size=1) +
geom_step(data=xyz[["plot"]][[2]], aes(xyz[["plot"]][[2]][[1]], xyz[["plot"]][[2]][[2]], col=v_treatment_names[2]), size=1)+
geom_step(data=xyz[["plot"]][[3]], aes(xyz[["plot"]][[3]][[1]], xyz[["plot"]][[3]][[2]], col=v_treatment_names[3]), size=1)+
geom_step(data=xyz[["plot"]][[4]], aes(xyz[["plot"]][[4]][[1]], xyz[["plot"]][[4]][[2]], col=v_treatment_names[4]), size=1)+
geom_step(data=xyz[["plot"]][[5]], aes(xyz[["plot"]][[5]][[1]], xyz[["plot"]][[5]][[2]], col=v_treatment_names[5]), linetype ="longdash")+
geom_step(data=xyz[["plot"]][[6]], aes(xyz[["plot"]][[6]][[1]], xyz[["plot"]][[6]][[2]], col=v_treatment_names[6]))+
geom_step(data=xyz[["plot"]][[7]], aes(xyz[["plot"]][[7]][[1]], xyz[["plot"]][[7]][[2]], col=v_treatment_names[7]), linetype ="dotted")+
geom_step(data=xyz[["plot"]][[8]], aes(xyz[["plot"]][[8]][[1]], xyz[["plot"]][[8]][[2]], col=v_treatment_names[8]), linetype ="dotdash") +
labs(title ="Predicted mortality over time - HARRMS Model ", y = "Survival (probability)", x = "Time (years)") +
theme_bw() +
theme(legend.position = "bottom")
plot_mortality
