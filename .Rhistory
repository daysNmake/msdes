psa_ipd <- bind_rows(map(results$output_psa, "merged_df"))
#all patients, sim1 on Nat-IV
patient_ipd <- psa_ipd[ psa_ipd$trt == "Natalizumab-IV"]
dim(patient_ipd)
dim(patient_ipd[simulation == i_sample])
dim(patient_ipd[simulation == i_sample][pat_id == i_patient])
dim(patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,])
patient_ipd<- cbind(patient_ipd,"trt_cost" = 0, "relapse_cost" =0, "sae_cost"=0, "hs_cost"=0, "disc_trt_cost"=0, "disc_relapse_cost" =0, "disc_sae_cost"=0, "disc_hs_cost"=0, "tot_posthoc"=0)
for(i_sample in 1:n_samples) {
for(i_patient in 1:n_patients) {
for (row_i in 1:nrow(patient_ipd[simulation == i_sample][pat_id == i_patient])) {
if(patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,evtname == "annual_treatment" & years_on_treatment <= 1]) {
patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,"trt_cost"] <- (1- patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,treatment_stop] ) *(
(1 - patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,spms_flag]) * (df_c_tx["cost_annual_yr1",patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,current_treatment_code]] +
v_c_trt_admin["cost_annual_yr1",patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,current_treatment_code]] +
v_c_trt_monitor["cost_annual_yr1",patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,current_treatment_code]]
) +
(patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,spms_flag] * (((1-p_siponimod) * df_c_spms["cost_annual_yr1","PegIFN-β-1 SC 125μg"]) +
(p_siponimod * df_c_spms["cost_annual_yr1","Siponimod"])))
)
} else if (patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,evtname == "annual_treatment" & years_on_treatment == 2]) {
patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,"trt_cost"] <- (1- patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,"treatment_stop"] ) *(
(1 - patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,spms_flag]) * (df_c_tx["cost_annual_yr2",patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,current_treatment_code]] +
v_c_trt_admin["cost_annual_yr2",patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,current_treatment_code]] +
v_c_trt_monitor["cost_annual_yr2",patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,current_treatment_code]]
) +
(patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,spms_flag] * (((1-p_siponimod) * df_c_spms["cost_annual_yr2","PegIFN-β-1 SC 125μg"]) +
(p_siponimod * df_c_spms["cost_annual_yr2","Siponimod"])))
)
} else if (patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,evtname == "annual_treatment" & years_on_treatment == 3]) {
patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,"trt_cost"] <- (1- patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,treatment_stop] ) *(
(1 - patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,spms_flag]) * ((df_c_tx["cost_annual_yr2",patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,current_treatment_code]] +
v_c_trt_admin["cost_annual_yr2",patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,current_treatment_code]] +
v_c_trt_monitor["cost_annual_yr2",patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,current_treatment_code]]
) * df_c_tx_load[3,patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,current_treatment_code]]) +
(patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,spms_flag] * (((1-p_siponimod) * df_c_spms["cost_annual_yr2","PegIFN-β-1 SC 125μg"]) +
(p_siponimod * df_c_spms["cost_annual_yr2","Siponimod"])))
)
} else if (patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,evtname == "annual_treatment" & years_on_treatment == 4]) {
patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,"trt_cost"] <- (1- patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,"treatment_stop"] ) *(
(1 - patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,spms_flag]) * ((df_c_tx["cost_annual_yr2",patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,current_treatment_code]] +
v_c_trt_admin["cost_annual_yr2",patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,current_treatment_code]] +
v_c_trt_monitor["cost_annual_yr2",patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,current_treatment_code]]
)  * df_c_tx_load[4,patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,current_treatment_code]]) +
(patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,spms_flag] * (((1-p_siponimod) * df_c_spms["cost_annual_yr2","PegIFN-β-1 SC 125μg"]) +
(p_siponimod * df_c_spms["cost_annual_yr2","Siponimod"])))
)
}
else if (patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,evtname == "annual_treatment" &  years_on_treatment >= 5]) {
patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,"trt_cost"] <- (1- patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,"treatment_stop"] ) *(
(1 - patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,spms_flag]) * ((df_c_tx["cost_annual_yr2",patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,current_treatment_code]] +
v_c_trt_admin["cost_annual_yr2",patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,current_treatment_code]] +
v_c_trt_monitor["cost_annual_yr2",patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,current_treatment_code]]
)  * df_c_tx_load[5,patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,current_treatment_code]]) +
(patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,spms_flag] * (((1-p_siponimod) * df_c_spms["cost_annual_yr2","PegIFN-β-1 SC 125μg"]) +
(p_siponimod * df_c_spms["cost_annual_yr2","Siponimod"])))
)
} #else {patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,trt_cost] <- 0}
if(patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,evtname == "relapse"]) {
patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,"relapse_cost"] <- (patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,relapse_hospital_flag]* v_c_relapse[6])+
((1 - patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,relapse_hospital_flag] ) * v_c_relapse[4])
} #else {patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,relapse_cost] <- 0}
if(patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,evtname == "serious_adverse_event"]) {
patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,"sae_cost"] <- (1- patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,treatment_stop]) * sum(v_c_sae_events * v_weight_sae)
} #else {patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,sae_cost] <- 0}
patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,"hs_cost"] <- (1 - patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,spms_flag]) * (v_c_rrms_edss[patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,edss_value] == v_edss_values]) +
(patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,spms_flag] * v_c_spms_edss[patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,edss_value] == v_edss_values])
}
}
}
lcldrc=0.035
for(i_sample in 1:n_samples) {
for(i_patient in 1:n_patients) {
for (row_i in 1:nrow(patient_ipd[simulation == i_sample][pat_id == i_patient])) {
#  if (patient_ipd[row_i,trt_cost > 0] ) {
patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,"disc_trt_cost"]<- patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,trt_cost] *  ((1+lcldrc)^(-patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,curtime])) # Note use of DISCRETE TIME discounting for instantaneous costs and benefits
#    } else {patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,"disc_trt_cost"]<-0}
patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,"disc_relapse_cost"] <- patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,relapse_cost] *  ((1+lcldrc)^(-patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,curtime])) # Note use of DISCRETE TIME discounting for instantaneous costs and benefits
patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,"disc_sae_cost"] <- patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,sae_cost] *  ((1+lcldrc)^(-patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,curtime])) # Note use of DISCRETE TIME discounting for instantaneous costs and benefits
#patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,disc_hs_cost] <- patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,hs_cost] *  ((1+lcldrc)^(-patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,curtime])) # ongoing not instantaious costs
}
}}
Instantdrc <- log(1+lcldrc)
for(i_sample in 1:n_samples) {
for(i_patient in 1:n_patients) {
for (row_i in 1:nrow(patient_ipd[simulation == i_sample][pat_id == i_patient])) {
#if (patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,hs_cost > 0] ) {
patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,"disc_hs_cost"] <- ((patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,hs_cost])/(0 - Instantdrc)) * (exp(patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,curtime] * ( 0 - Instantdrc)) - exp(patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,prevtime] * (0 - Instantdrc)))
#} #else {patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,disc_hs_cost] <-0}
}
}}
## do the trt costs tally up? (must fix this by subtracting additional cost ( the health state costs))
for(i_sample in 1:n_samples) {
for(i_patient in 1:n_patients) {
for (row_i in 1:nrow(patient_ipd[simulation == i_sample][pat_id == i_patient])) {
patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,"tot_posthoc"] <- patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,disc_trt_cost]+ patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,disc_hs_cost] +
patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,disc_relapse_cost] + patient_ipd[simulation == i_sample][pat_id == i_patient][row_i,disc_sae_cost]
}
}}
## do the all costs tally up?
post_hoc_cost <- model_cost <- delta_cost <-  array(NA, dim = c(n_samples,n_patients),
dimnames = list(NULL))
for(i_sample in 1:n_samples) {
for(i_patient in 1:n_patients) {
for (row_i in 1:nrow(patient_ipd[simulation == i_sample][pat_id == i_patient])) {
post_hoc_cost[i_patient] <- sum(patient_ipd[simulation == i_sample][pat_id == i_patient][,"disc_trt_cost"])
model_cost[i_patient] <- sum(patient_ipd[simulation == i_sample][pat_id == i_patient][,"cost"])
delta_cost[i_patient] <- ((post_hoc_cost[i_patient] - model_cost[i_patient]) / model_cost[i_patient]) * 100
}
}
}
paste(delta_cost, "%")
