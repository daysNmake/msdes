calculate_mean <- function(values){
total <- 0.0
count <- 0
for (value in values){
total <- total + value
count <- count + 1
}
return(total / count)
}
person_heights = c(1.62, 1.80, 1.56, 1.73, 1.91)
average_height <- calculate_mean(person_heights)
cat(sprintf("The average height is %.2f m\n", average_height))
calculate_mean <- function(values){
total <- 0.0
count <- 0
for (value in values){
total <- total + value
count <- count + 1
print(total)
print(count)
}
return(total / count)
}
person_heights = c(1.62, 1.80, 1.56, 1.73, 1.91)
average_height <- calculate_mean(person_heights)
cat(sprintf("The average height is %.2f m\n", average_height))
library(tidyverse)
cats <- read_csv("https://raw.githubusercontent.com/Bristol-Training/intermediate-r/refs/heads/main/data/cats.csv")
mean_cats<-calculate_mean(cats)
View(cats)
mean_cats<-calculate_mean(cats["BodyWeight"])
mean_cats<-calculate_mean(cats[,"BodyWeight"])
summary(cats)
cats %>% summary()
cats %>% summarise("BodyWeight")
cats %>% summarise(filter("BodyWeight"))
cats %>% filter("BodyWeight")
cats %>% filter(Sex=="F"")
cats %>% filter(Sex=="F")
cats %>% filter(Sex=="F")
cats %>% summary(filter(Sex=="F"))
cats %>% summary(filter(Sex=="M"))
cats %>% filter(Sex=="F") %>% summary()
cats %>% filter(Sex=="F") %>% filter(BodyWeight > 2.5)%>% summary()
cats %>% filter(Sex=="F") %>% filter(BodyWeight > 2.5)%>% summarise()
cats %>% filter(Sex=="F") %>% filter(BodyWeight > 2.5)%>% summarise(mean=mean(HeartWeight))
cats %>% filter(Sex=="F") %>% filter(BodyWeight > 2.5)%>% summarise(mean(HeartWeight))
cats %>% filter(Sex=="F") %>% filter(BodyWeight > 2.5)%>% summarise(summary(HeartWeight))
cats %>% filter(Sex=="F") %>% filter(BodyWeight > 2.5)%>% reframe(summary(HeartWeight))
cats %>%
filter(Sex=="F") %>%
filter(BodyWeight > 2.5) %>%
summary()
cats %>%
group_by(Sex) %>%
filter(BodyWeight > 2.5) %>%
